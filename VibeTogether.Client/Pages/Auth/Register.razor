@page "/register"
@inject RegisterViewModel VM

<h3>Register</h3>

<input placeholder="Username" @bind="VM.Username" />
<br />

<input placeholder="Email" @bind="VM.Email" />
<br />

<input placeholder="Password"
       type="password"
       @bind="VM.Password" />
<br />

<button @onclick="VM.RegisterAsync">Register</button>

@if (!string.IsNullOrEmpty(VM.Error))
{
    <p style="color:red">@VM.Error</p>
}
